# Copy to .env and fill in. Never commit .env.

# Database
POSTGRES_DB=estrella
POSTGRES_USER=estrella
POSTGRES_PASSWORD=CAMBIAR

# Web: the panel and the programs must be different sites (here localhost vs 127.0.0.1)
PANEL_ORIGIN=http://localhost:8088
APPS_ORIGIN=http://127.0.0.1:8089

# API
# At least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=CAMBIAR
# Encrypts each student's OpenRouter key at rest. Exactly 32 random bytes in base64:
# openssl rand -base64 32. Changing it makes every student connect the assistant again.
AI_KEY_SECRET=CAMBIAR
APP_PUBLIC_URL=http://localhost:8088
APP_CORS_ORIGINS=http://localhost:8088,http://localhost:5173
# Local compose runs over plain http; production must use true
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Strict
APP_STORAGE_QUOTA_BYTES=26214400
# Optional sync limits (defaults shown): bytes per encrypted version, versions kept per project,
# projects per account, uploads per minute per account.
APP_SYNC_MAX_VERSION_BYTES=10485760
APP_SYNC_VERSIONS_KEPT=5
APP_SYNC_MAX_PROJECTS=500
APP_SYNC_UPLOADS_PER_MINUTE=60

# Assistant (OpenRouter, OAuth PKCE). Compose points it at the local simulator by default. For the
# real service, use APP_AI_BASE_URL=https://openrouter.ai/api/v1 and APP_AI_AUTH_URL=https://openrouter.ai/auth.
# APP_AI_MODELS accepts only ":free" models or openrouter/free: the API refuses to start otherwise.
APP_AI_BASE_URL=http://openrouter-sim:8091/api/v1
APP_AI_AUTH_URL=http://127.0.0.1:8091/auth
APP_AI_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
APP_AI_REQUESTS_PER_MINUTE=6
APP_AI_MAX_MESSAGE_CHARS=4000
APP_AI_MAX_OUTPUT_TOKENS=800
APP_AI_TIMEOUT=60s

# Email (compose uses the local Mailpit inbox at http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@estrella.local
