# Rendered at container start: ${PANEL_ORIGIN} and ${APPS_ORIGIN} come from the environment.

# Panel: account, catalog and project storage.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 320k;

    # Frames may only come from the programs site, and frame navigations cannot leave it.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-src ${APPS_ORIGIN}; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        # Encrypted project versions are up to 10 MB (app.sync.max-version-bytes); nginx's default is 1 MB.
        client_max_body_size 11m;
    }

    # Programs are not served from the panel's site.
    location /apps/ {
        return 404;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy $csp always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy $csp always;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 512;
}

# Programs site: a different site than the panel, so browsers run programs in their own process.
server {
    listen 8081;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # Module workers (pdf.js) use .mjs, which nginx's default types do not know; browsers refuse
    # to run a module served as octet-stream.
    location ~* ^/apps/.+\.mjs$ {
        types { }
        default_type application/javascript;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' data: blob:; object-src 'none'; base-uri 'none'" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The DWG reader's glue code (Emscripten embind) builds small functions with new Function(),
    # so this one worker, and nothing else, may evaluate strings. It is a dedicated worker: no
    # page, no DOM, no panel storage, no network beyond this site; it only sees the DWG it is given.
    location ~ ^/apps/assets/dwg\.worker-[A-Za-z0-9_-]+\.js$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self'; base-uri 'none'" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Hashed build files never change: cache them for a year so programs open instantly next time.
    # A CSP header on a script only matters when the script starts a worker. Workers here (DWG
    # reader, font subsetting) compile WebAssembly, so they may; they still reach only this site.
    location /apps/assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' data: blob:; object-src 'none'; base-uri 'none'" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Visor compiles WebAssembly readers (IFC on the page, DWG in a worker), the only program that
    # needs 'wasm-unsafe-eval'. It allows compiling wasm served by this site, not eval().
    location /apps/visor/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors ${PANEL_ORIGIN}" always;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /apps/ {
        include /etc/nginx/snippets/security-headers.conf;
        # Embeddable only by the panel. Programs may load their own files from this site (fonts,
        # workers, chunks) but nothing from elsewhere. Inline styles are allowed because the
        # integrated editors inject them; inline scripts and eval are not.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors ${PANEL_ORIGIN}" always;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        return 404;
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/wasm;
    gzip_min_length 512;
}
